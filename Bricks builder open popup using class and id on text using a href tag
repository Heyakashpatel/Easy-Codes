document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.popup-link').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      // Replace 9999 with the actual numeric ID of your Bricks Popup Template
      if (typeof bricksOpenPopup === 'function') bricksOpenPopup(9999);
    });
  });
});



